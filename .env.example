# Copy to .env and fill in. .env is never committed; this file is, so it holds
# names and example values only, never a real key, token or password.
# .env is read by python-dotenv and also sourced by a shell: quote values that
# contain spaces, backslashes or JSON.

# --- AI Factory model -------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_REVIEWER_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=replace_me

# A CLI provider instead (no API key: the CLI's signed-in session is used).
# AI_PROVIDER=codex-cli        # or claude-cli
# AI_MODEL=gpt-5.6-sol
# AI_REVIEWER_MODEL=gpt-5.6-sol
# AI_CODEX_EXECUTABLE=codex
# AI_CODEX_REASONING_EFFORT=medium
# CODEX_HOME=/home/gitlab-runner/.codex

# --- Repository integration (issues and draft merge/pull requests) ----------
GITLAB_URL=https://gitlab.example.com
GITLAB_PROJECT_ID=replace_me
GITLAB_TOKEN=replace_me
# GITHUB_REPOSITORY=owner/repository
# GITHUB_TOKEN=replace_me

# --- RAG service ------------------------------------------------------------
# Defaults match infra/rag/compose.yaml.
RAG_DATABASE_URL=postgresql://aifactory_rag:aifactory_rag@localhost:5432/aifactory_rag
RAG_API_BIND=127.0.0.1
RAG_API_PORT=8765
RAG_WEB_BIND=127.0.0.1
RAG_WEB_PORT=8080
RAG_WEB_API_UPSTREAM=http://host.docker.internal:8765
# The endpoint consumer projects ground their requirements on.
RAG_CHAT_URL=http://127.0.0.1:8765/query

# --- RAG sources ------------------------------------------------------------
# factory.config.json has eight slots, RAG_SOURCE_1 .. RAG_SOURCE_8. A slot is a
# source once it names a folder, a repository or a DOORS server; the three can
# be combined, and are then one corpus under one ID.
RAG_SOURCE_1_ID=source-1
# The folder input.
RAG_SOURCE_1_PATH="/mnt/company-share/source 1"
# Globs left out, on top of the built-in ones.
RAG_SOURCE_1_EXCLUDE_ADDITIONS='[]'
# off keeps the source's rows but neither ingests nor searches it.
# RAG_SOURCE_1_ENABLED=on

# GitLab repositories, numbered; each with its own token.
# RAG_SOURCE_1_REPO_1_URL=https://gitlab.example.com/group/project
# RAG_SOURCE_1_REPO_1_TOKEN=replace_me
# RAG_SOURCE_1_REPO_1_REF=main                 # a branch or tag, @last-release or @last-tag
# RAG_SOURCE_1_REPO_1_WEBHOOK_SECRET=replace_me  # a push webhook keeps the source current
# A whole GitLab group.
# RAG_SOURCE_1_GROUP_1_URL=https://gitlab.example.com/group
# RAG_SOURCE_1_GROUP_1_TOKEN=replace_me
# RAG_SOURCE_1_GROUP_1_PROJECT_EXCLUDE='["**/archive-*"]'
# Joern data-flow graphs of the source's code.
# RAG_SOURCE_1_DATAFLOW=on

# IBM DOORS servers (classic DOORS 9.x), numbered: DOORS_1, DOORS_2, ... each a
# different server. The export runs on the server's own DOORS client, reached
# over SSH as SSH_USER with the key of the account the RAG service runs as.
# RAG_SOURCE_1_DOORS_1_SERVER=192.168.2.101        # add :port when it is not 36677
# RAG_SOURCE_1_DOORS_1_SSH_USER='DOMAIN\account'
# RAG_SOURCE_1_DOORS_1_USER=reader                 # the DOORS login
# RAG_SOURCE_1_DOORS_1_PASSWORD=replace_me
# Projects, folders or modules; every formal module under them. Default: everything.
# RAG_SOURCE_1_DOORS_1_PATHS='["/PROJECT", "/OTHER/Folder/One Module"]'
# Globs on a module's full name, left out of what PATHS selects.
# RAG_SOURCE_1_DOORS_1_EXCLUDE='["**/TEMPLATES/**"]'
# Only when the DOORS client is not on the DOORS server: the PCs that have one.
# RAG_DOORS_CLIENTS=user@192.168.1.57,user@192.168.1.111
# RAG_DOORS_EXECUTABLE=                            # doors.exe, when not under Program Files
# RAG_DOORS_MIRROR_DIR=/srv/rag-sources/doors
# RAG_DOORS_TIMEOUT_SECONDS=600

RAG_SOURCE_2_ID=source-2
RAG_SOURCE_2_PATH=/mnt/company-share/source-2
RAG_SOURCE_2_EXCLUDE_ADDITIONS='[]'

# Where repositories are mirrored and data-flow graphs are built.
# RAG_GIT_MIRROR_DIR=/srv/rag-sources/git
# RAG_JOERN_URL=http://127.0.0.1:8090
# RAG_JOERN_WORKSPACE=/srv/rag-sources/joern

# --- RAG embeddings ---------------------------------------------------------
# local runs in-process on CPU: no key, no service.
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DIMENSIONS=384
RAG_EMBEDDING_CACHE_DIR=./.cache/fastembed
# Set after preloading the cache, or point MODEL_PATH at an unpacked ONNX model.
RAG_EMBEDDING_MODEL_PATH=
RAG_EMBEDDING_LOCAL_FILES_ONLY=false
RAG_EMBEDDING_THREADS=4

# Ollama instead: one address, or several separated by commas, the preferred
# one first; a batch is shared between the hosts that answer.
# RAG_EMBEDDING_PROVIDER=ollama
# RAG_EMBEDDING_MODEL=qwen3-embedding:8b
# RAG_EMBEDDING_DIMENSIONS=2000
# RAG_EMBEDDING_BASE_URL=http://192.168.1.57:11434,http://192.168.1.111:11434
# RAG_EMBEDDING_HOST_RETRY_SECONDS=60
# RAG_EMBEDDING_TIMEOUT_SECONDS=600
# RAG_EMBEDDING_QUERY_INSTRUCTION=

# --- RAG answers and retrieval ----------------------------------------------
RAG_LLM_PROVIDER=gemini
RAG_LLM_MODEL=gemini-2.5-flash
# The API key of the embedding and answer providers (Gemini, OpenAI, Claude).
# Not needed with local or Ollama embeddings and a CLI answer model.
RAG_API_KEY=replace_me
# The Claude Code CLI instead (its signed-in session, no API key).
# RAG_LLM_PROVIDER=claude-cli
# RAG_LLM_MODEL=claude-opus-5-5
# RAG_LLM_EFFORT=medium
# RAG_LLM_TIMEOUT_SECONDS=300
# RAG_TOP_K=12
# RAG_EF_SEARCH=400              # candidates the vector index keeps while searching (40..1000)

# --- RAG ingest tuning ------------------------------------------------------
# RAG_INGEST_BATCH_SIZE=50
# RAG_INGEST_DUTY_CYCLE=1        # below 1 rests the embedding GPU between batches
# RAG_INGEST_ORDER=size          # smallest file first, or path

# --- Sign-in (only when rag.auth.enabled is true and the provider is entra) --
ENTRA_TENANT_ID=replace_me
ENTRA_AUDIENCE=api://replace_me
