# Required AI Factory model settings.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_REVIEWER_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=replace_me

# Codex CLI model provider (pipeline requirements only). Authentication is
# read by Codex from $CODEX_HOME/auth.json; no API key is used.
# AI_PROVIDER=codex-cli
# AI_MODEL=gpt-5.6-sol
# AI_REVIEWER_MODEL=gpt-5.6-sol
# AI_CODEX_EXECUTABLE=codex
# AI_CODEX_REASONING_EFFORT=medium
# CODEX_HOME=/home/gitlab-runner/.codex

# RAG database. Defaults match infra/rag/compose.yaml.
RAG_DATABASE_URL=postgresql://aifactory_rag:aifactory_rag@localhost:5432/aifactory_rag
RAG_API_BIND=127.0.0.1
RAG_API_PORT=8765
RAG_WEB_BIND=127.0.0.1
RAG_WEB_PORT=8080
RAG_WEB_API_UPSTREAM=http://host.docker.internal:8765

# Mounted document source IDs and paths. Quote paths containing spaces in .env.
RAG_SOURCE_1_ID=source-1
RAG_SOURCE_1_PATH=/Volumes/company-share/source-1
RAG_SOURCE_2_ID=source-2
RAG_SOURCE_2_PATH=/Volumes/company-share/source-2
RAG_SOURCE_3_ID=source-3
RAG_SOURCE_3_PATH=/Volumes/company-share/source-3
RAG_SOURCE_4_ID=simics-code
RAG_SOURCE_4_PATH="/mnt/fs1/1000 AR-GE/New folder/simics-6"

# RAG model settings. Gemini is the default for both embedding and answer generation.
RAG_EMBEDDING_PROVIDER=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_LLM_PROVIDER=gemini
RAG_LLM_MODEL=gemini-2.5-flash
RAG_API_KEY=replace_me

# Shared remote endpoint inherited by consumer project grounding settings.
RAG_CHAT_URL=http://192.168.1.2:8765/query

# Optional local provider URL when a RAG provider is set to "ollama".
# OLLAMA_BASE_URL=http://localhost:11434

# Required only when rag.auth.enabled is true and provider is "entra".
ENTRA_TENANT_ID=replace_me
ENTRA_AUDIENCE=api://replace_me

# GitLab Issue and Draft Merge Request integration
GITLAB_URL=https://gitlab.example.com
GITLAB_PROJECT_ID=replace_me
GITLAB_TOKEN=replace_me
