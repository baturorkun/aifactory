# --- Deploy (sh scripts/deploy.sh) ---------------------------------------------
# Copy these lines into .env and fill them. They are yours: CI reads
# deploy/main.env (main), deploy/branch.env (a branch) and deploy/release.env
# (a tag) instead; DEPLOY_PROFILE=main makes a developer's deploy read one too,
# this file filling what it leaves out. An agent never reads or writes them.
# What a deploy is: compose (the project's compose stack).
DEPLOY_TARGET=compose
# Where it goes: local (this machine) or remote (DEPLOY_REMOTE_HOST over ssh).
DEPLOY_ACCESS=
# Your name in the stack's name (<project>-dev-<you>); empty: your login name.
DEPLOY_USER=
# The host port on main; on another branch the port follows the branch.
DEPLOY_PORT=
DEPLOY_BRANCH_PORT_BASE=
# docker or podman on the target, used as named, with no fallback.
DEPLOY_DOCKER=
# The stack's directory on the target (~/ allowed): src/, runtime.env, data.
# Empty: ~/<compose project>.
DEPLOY_DIR=
# The compose project name; its volumes keep the data. Empty: <project>-dev-<you>.
DEPLOY_COMPOSE_PROJECT=
# The compose files in order; empty: compose.yml.
DEPLOY_COMPOSE_FILES=
# network:file pairs: the file is added only where the network exists.
DEPLOY_COMPOSE_OVERLAYS=
# The runtime.env names that receive the port and the image.
DEPLOY_COMPOSE_PORT_VAR=
DEPLOY_COMPOSE_IMAGE_VAR=
# NAME=hex<N> or NAME=base64url<N>: generated once on the target, never printed.
DEPLOY_ENV_SECRETS=
# path:NAME,NAME on the target: copied once when runtime.env lacks them.
DEPLOY_ENV_COPY=
# NAME=dir:uid: DEPLOY_DIR/dir made and given to uid, its path written as NAME.
DEPLOY_DATA_DIRS=
# Committed paths a build does not send (Git pathspec globs, space-separated),
# such as run records: runs handoffs.
DEPLOY_EXCLUDE=
# The path checked on 127.0.0.1:<port> after the stack is up; empty: /healthz.
DEPLOY_HEALTH_PATH=
# Any runtime.env line, written on every deploy: DEPLOY_ENV_SET_<NAME>=value.
# remote: the host, your account there and its ssh port.
DEPLOY_REMOTE_HOST=
DEPLOY_REMOTE_USER=
DEPLOY_REMOTE_PORT=22
# remote: required, files on this machine: your key and a known_hosts file
# with the host's key. A remote deploy stops at once without them.
DEPLOY_REMOTE_IDENTITY_FILE=
DEPLOY_REMOTE_KNOWN_HOSTS=
