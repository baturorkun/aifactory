# Where CI deploys a branch preview (scripts/deploy.sh --profile branch),
# started by hand from the Deploy workflow. Each branch is a compose stack of
# its own on the runner (<project>-<branch>), on port DEPLOY_BRANCH_PORT_BASE
# + the RQ number (factory/RQ-17 → 8117). Only local: a branch never sees the
# deploy key.
DEPLOY_TARGET=compose
DEPLOY_ACCESS=local
DEPLOY_DOCKER=docker
DEPLOY_BRANCH_PORT_BASE=8100
DEPLOY_HEALTH_PATH=/healthz
