# Where CI deploys a branch preview (scripts/deploy.sh --profile branch).
# A branch preview runs on the runner's own Docker: container
# <project>-preview-<branch>, port DEPLOY_BRANCH_PORT_BASE + the RQ number
# (factory/RQ-17 → 8117). Only container + local: a branch never sees the
# deploy key (it is protected) and the job cannot write the runner's disk.
DEPLOY_TARGET=container
DEPLOY_ACCESS=local
DEPLOY_DOCKER=docker
DEPLOY_BRANCH_PORT_BASE=8100
